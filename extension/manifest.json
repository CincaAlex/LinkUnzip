{
  "manifest_version": 3,
  "name": "LinkUnzip: extract ZIP files straight from links",
  "version": "1.0.0",
  "description": "Extract a ZIP from a link straight into a folder without saving the ZIP. Every file checked. Windows, with a small free helper app.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "notifications",
    "cookies",
    "downloads",
    "downloads.open",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkUnzip",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
