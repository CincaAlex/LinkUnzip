{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.1",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "offscreen",
    "contextMenus",
    "storage",
    "notifications",
    "downloads",
    "downloads.open",
    "downloads.ui",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LinkUnzip",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
